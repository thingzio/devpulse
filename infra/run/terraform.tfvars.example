# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Every variable below is REQUIRED -- variables.tf gives none of them a default,
# on purpose. Anything that identifies a particular deployment has to be stated
# rather than inherited, so Terraform cannot silently point at the maintainer's
# project. It refuses to plan until these are set.
#
# Variables NOT listed here keep sensible generic defaults: region, prefix,
# db_name, import_parallelism, import_workers, import_task_timeout,
# digest_admin_only, and sample_repos. Override any of them if you need to; see
# variables.tf.
#
# Note there are no secrets in this file. DevPulse keeps every secret value out
# of Terraform entirely -- secrets.tf creates empty Secret Manager containers
# and the values are set out of band with `gcloud secrets versions add`. The one
# exception is the database URL, which is assembled from a generated password.

# --- Deployment identity ---

# GCP project that will hold the Cloud Run services, secrets, and registry.
project_id = ""

# Public domain the service is served from.
domain = ""

# GitHub repository, used to scope Workload Identity Federation so only this
# repo's workflows can deploy. Format: owner/name.
git_repo = ""

# --- GitHub integration ---
#
# Self-hosters cannot use the maintainer's GitHub App: App private keys are per
# instance. Register your own at https://github.com/settings/apps/new with the
# callback set to https://<your domain>/auth/github/callback, then set the App
# ID and OAuth client ID below. Both are public identifiers; the client secret,
# webhook secret, and App private key go into Secret Manager out of band.

github_app_id          = ""
github_oauth_client_id = ""

# --- Contact and access ---

# Where infrastructure alerts are sent.
notification_email = ""

# Shown to users as the support contact.
support_email = ""

# Comma-separated GitHub usernames granted admin access.
admin_users = ""

# --- Shared infrastructure ---
#
# Referenced, never created by this configuration. Point these at network and
# database resources you already own. The maintainer's live in a separate
# private repository, which is why nothing here creates them.

vpc_id             = ""
subnet_id          = ""
db_instance_name   = ""
db_connection_name = ""  # project:region:instance
