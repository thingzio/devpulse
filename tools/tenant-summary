#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud terraform curl jq

msg "Fetching admin service URL..."
ADMIN_URL="$(cd "${REPO_ROOT}/infra/saas" && terraform output -raw admin_url 2>/dev/null)" \
    || err "Failed to get admin URL. Run 'terraform apply' in infra/saas first."

msg "Getting identity token..."
TOKEN="$(gcloud auth print-identity-token 2>/dev/null)" \
    || err "Failed to get identity token. Run 'gcloud auth login' first."

RESPONSE="$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${TOKEN}" \
    "${ADMIN_URL}/summary")"

HTTP_CODE="$(echo "${RESPONSE}" | tail -1)"
BODY="$(echo "${RESPONSE}" | sed '$d')"

if [[ "${HTTP_CODE}" != "200" ]]; then
    err "Failed (HTTP ${HTTP_CODE}): ${BODY}"
fi

DATE="$(echo "${BODY}" | jq -r '.date')"
UPDATED="$(echo "${BODY}" | jq -r '.updated_at')"

printf "\nDevPulse Platform Summary — %s (updated %s)\n\n" "${DATE}" "${UPDATED}"

echo "${BODY}" | jq -r '
def fmt_delta(d; pct):
    if d == null then "—"
    elif pct == null then (if d > 0 then "+\(d)" elif d < 0 then "\(d)" else "0" end)
    else (if d > 0 then "+\(d) (\(pct | . * 100 | round / 100)%)"
          elif d < 0 then "\(d) (\(pct | . * 100 | round / 100)%)"
          else "0 (0%)" end)
    end;

def row(label; val; dod_d; dod_p; wow_d; wow_p; mom_d; mom_p):
    [label,
     (val | tostring),
     fmt_delta(dod_d; dod_p),
     fmt_delta(wow_d; wow_p),
     fmt_delta(mom_d; mom_p)];

["METRIC", "CURRENT", "DoD", "WoW", "MoM"],
row("Tenants";        .current.tenants;           .dod.tenants; .dod.tenants_pct; .wow.tenants; .wow.tenants_pct; .mom.tenants; .mom.tenants_pct),
row("  Free";         .current.tenants_free;      .dod.tenants; null;             .wow.tenants; null;             .mom.tenants; null),
row("  Starter";      .current.tenants_starter;   null; null; null; null; null; null),
row("  Pro";          .current.tenants_pro;        null; null; null; null; null; null),
row("  Enterprise";   .current.tenants_enterprise; null; null; null; null; null; null),
row("Repos";          .current.repos;              .dod.repos; .dod.repos_pct; .wow.repos; .wow.repos_pct; .mom.repos; .mom.repos_pct),
row("Events";         .current.events;             .dod.events; .dod.events_pct; .wow.events; .wow.events_pct; .mom.events; .mom.events_pct),
row("Contributors";   .current.contributors;       .dod.contributors; .dod.contributors_pct; .wow.contributors; .wow.contributors_pct; .mom.contributors; .mom.contributors_pct),
row("Installations";  .current.installations;      .dod.installations; .dod.installations_pct; .wow.installations; .wow.installations_pct; .mom.installations; .mom.installations_pct),
row("Repos w/ Errors"; .current.repos_with_errors; .dod.repos_with_errors; .dod.repos_with_errors_pct; .wow.repos_with_errors; .wow.repos_with_errors_pct; .mom.repos_with_errors; .mom.repos_with_errors_pct)
| @tsv' | column -t -s $'\t'

# Error repos
ERROR_COUNT="$(echo "${BODY}" | jq '.error_repos | length')"
if [[ "${ERROR_COUNT}" -gt 0 ]]; then
    printf "\nREPOS WITH IMPORT ERRORS:\n"
    echo "${BODY}" | jq -r '
        ["ORG/REPO", "ERRORS", "LAST ERROR"],
        (.error_repos[] | ["\(.org)/\(.repo)", (.errors | tostring), .last_error])
        | @tsv' | column -t -s $'\t'
fi

echo ""
