#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud terraform cloud-sql-proxy psql

usage() {
    echo "Usage: $0 <username> <plan>"
    echo ""
    echo "Plans:"
    echo "  free        5 repos, 2,000 events/week"
    echo "  pro         25 repos, 20,000 events/week"
    echo "  enterprise  100 repos, 100,000 events/week"
    exit 1
}

[[ $# -ne 2 ]] && usage

USERNAME="$1"
PLAN="$2"

case "$PLAN" in
    free)       MAX_REPOS=5;   MAX_EVENTS=2000 ;;
    pro)        MAX_REPOS=25;  MAX_EVENTS=20000 ;;
    enterprise) MAX_REPOS=100; MAX_EVENTS=100000 ;;
    *)          err "Unknown plan: $PLAN (must be free, pro, or enterprise)" ;;
esac

PROJECT="${PROJECT_ID:-devpulseio}"
INSTANCE="devpulse-saas-pg"
DB="devpulse"
DB_USER="devpulse"

SQL="UPDATE tenant SET plan='${PLAN}', max_repos=${MAX_REPOS}, max_events_per_week=${MAX_EVENTS}, upgrade_requested_at=NULL, updated_at=NOW() WHERE username='${USERNAME}' RETURNING username, plan, max_repos, max_events_per_week;"

msg "Fetching DB password from Terraform state..."
DB_PASS="$(cd "${REPO_ROOT}/infra/saas" && terraform state pull 2>/dev/null \
    | python3 -c "import sys,json; resources=json.load(sys.stdin)['resources']; pw=[r for r in resources if r['type']=='random_password' and r['name']=='db_password']; print(pw[0]['instances'][0]['attributes']['result'])" 2>/dev/null)" \
    || err "Failed to get DB password from Terraform state."
[[ -z "${DB_PASS}" ]] && err "DB password is empty. Ensure Terraform state is accessible in infra/saas."

msg "Upgrading ${USERNAME} to ${PLAN} (${MAX_REPOS} repos, ${MAX_EVENTS} events/week)"

# Create temporary .pgpass file for non-interactive auth
PGPASS_FILE="$(mktemp)"
trap "rm -f ${PGPASS_FILE}" EXIT
echo "127.0.0.1:9470:${DB}:${DB_USER}:${DB_PASS}" > "${PGPASS_FILE}"
chmod 600 "${PGPASS_FILE}"

# Start Cloud SQL Proxy in background
cloud-sql-proxy "${PROJECT}:us-west1:${INSTANCE}" --port 9470 --quiet &
PROXY_PID=$!
trap "kill ${PROXY_PID} 2>/dev/null; rm -f ${PGPASS_FILE}" EXIT
sleep 3

PGPASSFILE="${PGPASS_FILE}" psql -h 127.0.0.1 -p 9470 -U "${DB_USER}" -d "${DB}" -c "${SQL}"

msg "Done"
