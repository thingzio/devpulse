#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud terraform curl jq

usage() {
    echo "Usage: $0 <username>"
    exit 1
}

[[ $# -ne 1 ]] && usage

USERNAME="$1"

msg "Fetching admin service URL..."
ADMIN_URL="$(cd "${REPO_ROOT}/infra/saas" && terraform output -raw admin_url 2>/dev/null)" \
    || err "Failed to get admin URL. Run 'terraform apply' in infra/saas first."

msg "Getting identity token..."
TOKEN="$(gcloud auth print-identity-token 2>/dev/null)" \
    || err "Failed to get identity token. Run 'gcloud auth login' first."

RESPONSE="$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${TOKEN}" \
    "${ADMIN_URL}/tenant?username=${USERNAME}")"

HTTP_CODE="$(echo "${RESPONSE}" | tail -1)"
BODY="$(echo "${RESPONSE}" | sed '$d')"

if [[ "${HTTP_CODE}" != "200" ]]; then
    err "Failed (HTTP ${HTTP_CODE}): ${BODY}"
fi

# Identity
echo ""
echo "IDENTITY"
echo "${BODY}" | jq -r '"  Username:  \(.username)\n  Email:     \(.email // "n/a")"'

# Status
echo ""
echo "STATUS"
echo "${BODY}" | jq -r '
    "  Plan:        \(.plan)",
    "  Repos:       \(.repos | length)/\(if .max_repos == 0 then "∞" else (.max_repos | tostring) end)",
    "  Events/Wk:   \(if .max_events_per_week == 0 then "∞" else (.max_events_per_week | tostring) end)",
    "  Created:     \(.created_at)",
    "  Last Login:  \(if .last_sign_in == "" or .last_sign_in == null then "never" else .last_sign_in end)"'

# Repos
echo ""
echo "REPOS"
echo "${BODY}" | jq -r '
    if (.repos | length) == 0 then "  (none)"
    else
        .max_events_per_week as $max |
        ["  NAME", "EVENTS", "WEEKLY", "WEEKLY-%", "CONTRIBS", "SCORED-%", "DEEP-%", "NO-DEEP", "BACKFILL", "LAST-IMPORT"],
        (.repos[] | [
            "  \(.name)",
            (.events | tostring),
            (.weekly_events | tostring),
            (if $max == 0 then "-" elif .weekly_pct == 0 then "0.0%" else "\(.weekly_pct | . * 10 | round / 10)%" end),
            (.contributors | tostring),
            (if .contributors == 0 then "-" else "\(.scored)/\(.contributors) (\(.scored * 100 / .contributors | round)%)" end),
            (if .contributors == 0 then "-" else "\(.deep_scored)/\(.contributors) (\(.deep_scored * 100 / .contributors | round)%)" end),
            (.never_deep_score | tostring),
            (if .pr_total == 0 then "-" elif .pr_missing_size == 0 then "done" else "\(.pr_total - .pr_missing_size)/\(.pr_total)" end),
            (if .last_import == "" then "never" else .last_import end)
        ]) | @tsv
    end' | column -t
echo ""
