#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud terraform curl jq

msg "Fetching admin service URL..."
ADMIN_URL="$(cd "${REPO_ROOT}/infra/saas" && terraform output -raw admin_url 2>/dev/null)" \
    || err "Failed to get admin URL. Run 'terraform apply' in infra/saas first."

msg "Getting identity token..."
TOKEN="$(gcloud auth print-identity-token 2>/dev/null)" \
    || err "Failed to get identity token. Run 'gcloud auth login' first."

RESPONSE="$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer ${TOKEN}" \
    "${ADMIN_URL}/tenants")"

HTTP_CODE="$(echo "${RESPONSE}" | tail -1)"
BODY="$(echo "${RESPONSE}" | sed '$d')"

if [[ "${HTTP_CODE}" != "200" ]]; then
    err "Failed (HTTP ${HTTP_CODE}): ${BODY}"
fi

echo "${BODY}" | jq -r '
    ["USERNAME", "NAME", "PLAN", "REPOS", "EVENTS/WK", "CREATED", "LAST-SIGN-IN"],
    (.[] | [
        .username,
        (if .name == "" or .name == null then "-" else .name end),
        .plan,
        (if .max_repos == 0 then "∞" else (.max_repos | tostring) end),
        (if .max_events_per_week == 0 then "∞" else (.max_events_per_week | tostring) end),
        .created_at,
        (if .last_sign_in == "" or .last_sign_in == null then "never" else .last_sign_in end)
    ]) | @tsv' | column -t -s $'\t'
