#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud curl

PROJECT="devpulseio"
INSTANCE="devpulse-saas-pg"
DB_NAME="devpulse"
DB_USER="devpulse"
NETWORK_NAME="break-glass"

usage() {
    echo "Usage: $0 <command>"
    echo ""
    echo "Commands:"
    echo "  open         Enable public IP, authorize your IP, connect with psql"
    echo "  open-silent  Enable public IP, authorize your IP (no psql, for scripting)"
    echo "  close        Remove your IP and disable public IP"
    echo ""
    echo "This is a break-glass tool for direct DB access."
    echo "Public IP is enabled only while connected, scoped to your IP."
    exit 1
}

[[ $# -lt 1 ]] && usage

my_ip() {
    curl -s https://checkip.amazonaws.com | tr -d '[:space:]'
}

do_authorize() {
    local ip
    ip="$(my_ip)"
    [[ -z "$ip" ]] && err "Failed to detect public IP"
    msg "Your public IP: ${ip}"

    msg "Enabling public IP on ${INSTANCE}..."
    gcloud sql instances patch "${INSTANCE}" \
        --project="${PROJECT}" \
        --assign-ip \
        --quiet

    msg "Authorizing ${ip}/32..."
    gcloud sql instances patch "${INSTANCE}" \
        --project="${PROJECT}" \
        --authorized-networks="${ip}/32" \
        --quiet
}

do_open() {
    do_authorize

    msg "Connecting (Ctrl-C to disconnect, then run '$0 close')..."
    echo ""
    gcloud sql connect "${INSTANCE}" \
        --project="${PROJECT}" \
        --database="${DB_NAME}" \
        --user="${DB_USER}"
}

do_close() {
    msg "Removing authorized networks..."
    gcloud sql instances patch "${INSTANCE}" \
        --project="${PROJECT}" \
        --clear-authorized-networks \
        --quiet

    msg "Disabling public IP..."
    gcloud sql instances patch "${INSTANCE}" \
        --project="${PROJECT}" \
        --no-assign-ip \
        --quiet

    msg "Public IP disabled and all authorized networks removed."
}

case "${1}" in
    open)        do_open ;;
    open-silent) do_authorize ;;
    close)       do_close ;;
    *)           usage ;;
esac
