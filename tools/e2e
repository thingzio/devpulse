#!/bin/bash
set -euo pipefail

err() { echo "FAIL: $*" >&2; exit 1; }
pass() { echo "PASS: $*"; }

# Require dependencies
command -v go >/dev/null 2>&1 || err "go is required"

# Build binary to temp directory, clean up on exit
TMPDIR_E2E=$(mktemp -d)
trap 'rm -rf "$TMPDIR_E2E"' EXIT
BIN="$TMPDIR_E2E/devpulse"

echo "==> Building devpulse binary..."
go build -mod=vendor -o "$BIN" ./cmd/devpulse
[[ -x "$BIN" ]] || err "binary not found after build"

FAILURES=0

# --------------------------------------------------------------------------
# Test: missing DATABASE_URL starts import mode and fails with clear error
# --------------------------------------------------------------------------
if output=$(DATABASE_URL="" "$BIN" 2>&1); then
  echo "FAIL: missing-database-url (expected non-zero exit)"; FAILURES=$((FAILURES + 1))
else
  if echo "$output" | grep -qi "DATABASE_URL"; then
    pass "missing-database-url (import mode)"
  else
    echo "FAIL: missing-database-url (expected DATABASE_URL in error)"; FAILURES=$((FAILURES + 1))
  fi
fi

# --------------------------------------------------------------------------
# Test: missing DATABASE_URL with PORT set starts serve mode and fails
# --------------------------------------------------------------------------
if output=$(DATABASE_URL="" PORT=8080 "$BIN" 2>&1); then
  echo "FAIL: missing-database-url-serve (expected non-zero exit)"; FAILURES=$((FAILURES + 1))
else
  if echo "$output" | grep -qi "DATABASE_URL"; then
    pass "missing-database-url (serve mode)"
  else
    echo "FAIL: missing-database-url-serve (expected DATABASE_URL in error)"; FAILURES=$((FAILURES + 1))
  fi
fi

# --------------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------------
echo ""
if [[ $FAILURES -gt 0 ]]; then
  err "$FAILURES test(s) failed"
fi
echo "==> All e2e tests passed"
