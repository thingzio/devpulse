#!/bin/bash
set -euo pipefail

err() { echo "FAIL: $*" >&2; exit 1; }
pass() { echo "PASS: $*"; }

# Require dependencies
command -v go >/dev/null 2>&1 || err "go is required"

# Build binaries to temp directory, clean up on exit
TMPDIR_E2E=$(mktemp -d)
trap 'rm -rf "$TMPDIR_E2E"' EXIT

FAILURES=0

# --------------------------------------------------------------------------
# Build devpulse-site
# --------------------------------------------------------------------------
echo "==> Building devpulse-site..."
SITE="$TMPDIR_E2E/devpulse-site"
go build -mod=vendor -o "$SITE" ./cmd/devpulse-site
[[ -x "$SITE" ]] || err "devpulse-site binary not found after build"

# --------------------------------------------------------------------------
# Build devpulse-import
# --------------------------------------------------------------------------
echo "==> Building devpulse-import..."
IMPORT="$TMPDIR_E2E/devpulse-import"
go build -mod=vendor -o "$IMPORT" ./cmd/devpulse-import
[[ -x "$IMPORT" ]] || err "devpulse-import binary not found after build"

# --------------------------------------------------------------------------
# Test: devpulse-site missing DATABASE_URL fails with clear error
# --------------------------------------------------------------------------
if output=$(DATABASE_URL="" "$SITE" 2>&1); then
  echo "FAIL: site-missing-database-url (expected non-zero exit)"; FAILURES=$((FAILURES + 1))
else
  if echo "$output" | grep -qi "DATABASE_URL"; then
    pass "site-missing-database-url"
  else
    echo "FAIL: site-missing-database-url (expected DATABASE_URL in error)"; FAILURES=$((FAILURES + 1))
  fi
fi

# --------------------------------------------------------------------------
# Test: devpulse-import missing DATABASE_URL fails with clear error
# --------------------------------------------------------------------------
if output=$(DATABASE_URL="" "$IMPORT" 2>&1); then
  echo "FAIL: import-missing-database-url (expected non-zero exit)"; FAILURES=$((FAILURES + 1))
else
  if echo "$output" | grep -qi "DATABASE_URL"; then
    pass "import-missing-database-url"
  else
    echo "FAIL: import-missing-database-url (expected DATABASE_URL in error)"; FAILURES=$((FAILURES + 1))
  fi
fi

# --------------------------------------------------------------------------
# Summary
# --------------------------------------------------------------------------
echo ""
if [[ $FAILURES -gt 0 ]]; then
  err "$FAILURES test(s) failed"
fi
echo "==> All e2e tests passed"
