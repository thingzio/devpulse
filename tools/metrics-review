#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud terraform

DAYS="${1:-2}"
REPO_ROOT="$(cd "${DIR}/.." && pwd)"

ADMIN_URL="$(cd "${REPO_ROOT}/infra/saas" && terraform output -raw admin_url 2>/dev/null)" \
    || err "Failed to get admin URL. Run 'terraform apply' in infra/saas first."

TOKEN="$(gcloud auth print-identity-token 2>/dev/null)" \
    || err "Failed to get identity token. Run 'gcloud auth login' first."

msg "Fetching metrics analysis for last ${DAYS} day(s)..."

RESPONSE="$(curl -sf -H "Authorization: Bearer ${TOKEN}" \
    "${ADMIN_URL}/metrics/review?days=${DAYS}" 2>/dev/null)" \
    || err "Failed to call admin service. Check IAM permissions and service status."

echo "${RESPONSE}"
