#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${DIR}/common"

has_tools gcloud python3

DAYS="${1:-2}"
PROJECT="${DEVPULSE_GCP_PROJECT:-devpulseio}"
REGION="${DEVPULSE_GCP_REGION:-us-west1}"
SERVICE="devpulse-saas-serve"
JOB="devpulse-saas-import"
ADMIN="devpulse-saas-admin"
DB_ID="${PROJECT}:devpulse-saas-pg"

msg "Fetching metrics for last ${DAYS} day(s) from project ${PROJECT}..."

TOKEN="$(gcloud auth print-access-token 2>/dev/null)" \
    || err "Failed to get access token. Run 'gcloud auth login' first."

if [[ "$(uname)" == "Darwin" ]]; then
    START="$(date -u -v-${DAYS}d '+%Y-%m-%dT%H:%M:%SZ')"
else
    START="$(date -u -d "${DAYS} days ago" '+%Y-%m-%dT%H:%M:%SZ')"
fi
END="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

BASE="https://monitoring.googleapis.com/v3/projects/${PROJECT}/timeSeries"
LOG_BASE="https://logging.googleapis.com/v2/entries:list"

urlencode() {
    python3 -c "import urllib.parse; print(urllib.parse.quote('''$1'''))"
}

query_ts() {
    local filter="$1"
    local params="$2"
    local encoded
    encoded="$(urlencode "${filter}")"
    curl -sf -H "Authorization: Bearer ${TOKEN}" \
        "${BASE}?filter=${encoded}&interval.startTime=${START}&interval.endTime=${END}&${params}" 2>/dev/null || echo '{}'
}

query_logs() {
    local filter="$1"
    local size="${2:-10}"
    curl -sf -H "Authorization: Bearer ${TOKEN}" \
        "${LOG_BASE}" -X POST -H "Content-Type: application/json" \
        -d "{
            \"resourceNames\": [\"projects/${PROJECT}\"],
            \"filter\": \"${filter} AND timestamp>=\\\"${START}\\\"\",
            \"orderBy\": \"timestamp desc\",
            \"pageSize\": ${size}
        }" 2>/dev/null || echo '{}'
}

# helper: format time-series points as "HH:MM=value" lines
fmt_points() {
    python3 -c "
import json,sys
d=json.load(sys.stdin)
series=d.get('timeSeries',[])
if not series:
    print('  (no data)')
    sys.exit(0)
for ts in series:
    labels=ts.get('metric',{}).get('labels',{})
    prefix=' '.join(f'{v}' for v in labels.values()) if labels else ''
    pts=ts['points'][:${2:-8}]
    vals=', '.join(
        f\"{p['interval']['startTime'][5:16]}={float(p['value'].get('doubleValue',p['value'].get('int64Value',0))):.${1:-2}f}\"
        for p in pts
    )
    line=f'  {prefix}: {vals}' if prefix else f'  {vals}'
    print(line)
" 2>/dev/null
}

# helper: format daily aggregated points
fmt_daily() {
    python3 -c "
import json,sys
d=json.load(sys.stdin)
series=d.get('timeSeries',[])
if not series:
    print('  (no data)')
    sys.exit(0)
for ts in series:
    pts=ts['points'][:${1:-4}]
    vals=', '.join(
        f\"{p['interval']['startTime'][:10]}={int(float(p['value'].get('doubleValue',p['value'].get('int64Value',0))))}\"
        for p in pts
    )
    print(f'  {vals}')
" 2>/dev/null
}

printf "\n"
echo "================================================================="
echo " DevPulse Metrics Review — Last ${DAYS} day(s)"
echo " Project: ${PROJECT}  |  $(date -u '+%Y-%m-%d %H:%M UTC')"
echo "================================================================="

# ── Service: Request Count ──────────────────────────────────────────
printf "\n--- Service: Request Count (req/s by response class) ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/request_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_RATE&aggregation.crossSeriesReducer=REDUCE_SUM&aggregation.groupByFields=metric.labels.response_code_class" \
    | fmt_points 3

# ── Service: Request Latency ────────────────────────────────────────
printf "\n--- Service: Request Latency (ms) ---\n"
for perc in ALIGN_PERCENTILE_50 ALIGN_PERCENTILE_95 ALIGN_PERCENTILE_99; do
    label="${perc/ALIGN_PERCENTILE_/p}"
    query_ts \
        "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/request_latencies\"" \
        "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=${perc}&aggregation.crossSeriesReducer=REDUCE_MEAN" \
        | python3 -c "
import json,sys
d=json.load(sys.stdin)
for ts in d.get('timeSeries',[]):
    pts=ts['points'][:8]
    vals=', '.join(f\"{p['interval']['startTime'][5:16]}={float(p['value'].get('doubleValue',0)):.1f}\" for p in pts)
    print(f'  ${label}: {vals}')
if not d.get('timeSeries'): print('  ${label}: (no data)')
" 2>/dev/null
done

# ── Service: Instance Count ─────────────────────────────────────────
printf "\n--- Service: Instance Count ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/container/instance_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_MAX&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | python3 -c "
import json,sys
d=json.load(sys.stdin)
for ts in d.get('timeSeries',[]):
    pts=ts['points'][:12]
    scale=[p for p in pts if float(p['value'].get('doubleValue',p['value'].get('int64Value',0)))>1]
    vals=', '.join(f\"{p['interval']['startTime'][5:16]}={float(p['value'].get('doubleValue',p['value'].get('int64Value',0))):.0f}\" for p in pts[:8])
    print(f'  {vals}')
    if scale:
        print(f'  Scale events: {len(scale)} in period')
if not d.get('timeSeries'): print('  (no data)')
" 2>/dev/null

# ── Service: CPU Utilization ────────────────────────────────────────
printf "\n--- Service: CPU Utilization (p99 max) ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/container/cpu/utilizations\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_PERCENTILE_99&aggregation.crossSeriesReducer=REDUCE_MAX" \
    | fmt_points 4

# ── Service: Memory Utilization ─────────────────────────────────────
printf "\n--- Service: Memory Utilization (p99 max) ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/container/memory/utilizations\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_PERCENTILE_99&aggregation.crossSeriesReducer=REDUCE_MAX" \
    | fmt_points 4

# ── Service: Billable Instance Time ─────────────────────────────────
printf "\n--- Service: Billable Instance Time (rate) ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"run.googleapis.com/container/billable_instance_time\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_RATE&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_points 4

# ── Import: Job Execution Results ───────────────────────────────────
printf "\n--- Import: Job Execution Results ---\n"
query_ts \
    "resource.type=\"cloud_run_job\" AND resource.labels.job_name=\"${JOB}\" AND metric.type=\"run.googleapis.com/job/completed_execution_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_DELTA&aggregation.crossSeriesReducer=REDUCE_SUM&aggregation.groupByFields=metric.labels.result" \
    | fmt_points 0

# ── Import: Duration ────────────────────────────────────────────────
printf "\n--- Import: Duration (sec) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-import-duration\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_DELTA&aggregation.crossSeriesReducer=REDUCE_MEAN" \
    | fmt_points 1

# ── Import: Tenants per Run ─────────────────────────────────────────
printf "\n--- Import: Tenants per Run ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-import-tenant-count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_DELTA&aggregation.crossSeriesReducer=REDUCE_MEAN" \
    | fmt_points 1

# ── Import: Weekly Events per Tenant ────────────────────────────────
printf "\n--- Import: Weekly Events per Tenant ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-tenant-weekly-events\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_DELTA&aggregation.crossSeriesReducer=REDUCE_MEAN" \
    | fmt_points 0

# ── Import: Repo Errors (by org/repo) ──────────────────────────────
printf "\n--- Import: Repo Errors (by org/repo) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-import-repo-errors\"" \
    "aggregation.alignmentPeriod=$((DAYS*86400))s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM&aggregation.groupByFields=metric.labels.org&aggregation.groupByFields=metric.labels.repo" \
    | python3 -c "
import json,sys
d=json.load(sys.stdin)
repos=[]
for ts in d.get('timeSeries',[]):
    org=ts['metric']['labels'].get('org','?')
    repo=ts['metric']['labels'].get('repo','?')
    total=sum(float(p['value'].get('doubleValue',p['value'].get('int64Value',0))) for p in ts['points'])
    repos.append((int(total),f'{org}/{repo}'))
for count,name in sorted(repos,reverse=True):
    print(f'  {name}: {count}')
if not repos: print('  (no data)')
" 2>/dev/null

# ── Cloud SQL: CPU ──────────────────────────────────────────────────
printf "\n--- Cloud SQL: CPU Utilization ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/cpu/utilization\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_MEAN" \
    | fmt_points 4

# ── Cloud SQL: Memory ───────────────────────────────────────────────
printf "\n--- Cloud SQL: Memory Utilization ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/memory/utilization\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_MEAN" \
    | fmt_points 4

# ── Cloud SQL: Connections ──────────────────────────────────────────
printf "\n--- Cloud SQL: Connections ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/num_backends\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_MEAN" \
    | fmt_points 1

# ── Cloud SQL: Disk Used ────────────────────────────────────────────
printf "\n--- Cloud SQL: Disk Used ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/disk/bytes_used\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_MEAN" \
    | python3 -c "
import json,sys
d=json.load(sys.stdin)
for ts in d.get('timeSeries',[]):
    pts=ts['points'][:8]
    vals=', '.join(f\"{p['interval']['startTime'][5:16]}={float(p['value'].get('doubleValue',p['value'].get('int64Value',0)))/1048576:.1f}MB\" for p in pts)
    print(f'  {vals}')
if not d.get('timeSeries'): print('  (no data)')
" 2>/dev/null

# ── Cloud SQL: Transactions/sec ─────────────────────────────────────
printf "\n--- Cloud SQL: Transactions/sec ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/transaction_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_RATE&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_points 2

# ── Cloud SQL: Deadlocks ───────────────────────────────────────────
printf "\n--- Cloud SQL: Deadlocks ---\n"
query_ts \
    "resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"${DB_ID}\" AND metric.type=\"cloudsql.googleapis.com/database/postgresql/deadlock_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_DELTA&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_points 0

# ── Business Metrics (daily) ───────────────────────────────────────
printf "\n--- Sign-ins (daily) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-sign-ins\"" \
    "aggregation.alignmentPeriod=86400s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_daily

printf "\n--- ToS Accepted (daily) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-tos-accepted\"" \
    "aggregation.alignmentPeriod=86400s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_daily

printf "\n--- Upgrade Requests (daily) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-upgrade-requests\"" \
    "aggregation.alignmentPeriod=86400s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_daily

printf "\n--- Webhook Installations (daily) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-webhook-installs\"" \
    "aggregation.alignmentPeriod=86400s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_daily

printf "\n--- Event Limit Reached (daily) ---\n"
query_ts \
    "metric.type=\"logging.googleapis.com/user/devpulse-saas-event-limit-reached\"" \
    "aggregation.alignmentPeriod=86400s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_daily

# ── Application Errors ──────────────────────────────────────────────
printf "\n--- Application Errors (hourly) ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND metric.type=\"logging.googleapis.com/log_entry_count\" AND metric.labels.severity=\"ERROR\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_SUM&aggregation.crossSeriesReducer=REDUCE_SUM" \
    | fmt_points 0

# ── Application Error Details ───────────────────────────────────────
printf "\n--- Application Error Log Entries (last 5) ---\n"
query_logs "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\" AND severity=\"ERROR\"" 5 \
    | python3 -c "
import json,sys
d=json.load(sys.stdin)
for e in d.get('entries',[]):
    ts=e.get('timestamp','?')[:19]
    payload=e.get('textPayload','')
    if not payload:
        jp=e.get('jsonPayload',{})
        payload=jp.get('message',jp.get('msg',str(jp)[:200]))
    print(f'  [{ts}] {payload[:200]}')
if not d.get('entries'): print('  (none)')
" 2>/dev/null

# ── Import Job Errors ───────────────────────────────────────────────
printf "\n--- Import Job Errors (last 5) ---\n"
query_logs "resource.type=\"cloud_run_job\" AND resource.labels.job_name=\"${JOB}\" AND severity>=ERROR" 5 \
    | python3 -c "
import json,sys
d=json.load(sys.stdin)
for e in d.get('entries',[]):
    ts=e.get('timestamp','?')[:19]
    payload=e.get('textPayload','')
    if not payload:
        jp=e.get('jsonPayload',{})
        payload=jp.get('message',jp.get('msg',str(jp)[:200]))
    print(f'  [{ts}] {payload[:200]}')
if not d.get('entries'): print('  (none)')
" 2>/dev/null

# ── Admin: Request Count ────────────────────────────────────────────
printf "\n--- Admin: Request Count ---\n"
query_ts \
    "resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${ADMIN}\" AND metric.type=\"run.googleapis.com/request_count\"" \
    "aggregation.alignmentPeriod=3600s&aggregation.perSeriesAligner=ALIGN_RATE&aggregation.crossSeriesReducer=REDUCE_SUM&aggregation.groupByFields=metric.labels.response_code_class" \
    | fmt_points 3

printf "\n=================================================================\n"
msg "Review complete."
